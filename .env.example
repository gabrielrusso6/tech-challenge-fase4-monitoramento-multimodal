# Copie para .env e preencha. NUNCA faça commit do .env.
# Azure AI Speech (Speech to Text / Text to Speech)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_LOCALE=pt-BR

# Azure AI Language (Text Analytics: sentimento, frases-chave, Text Analytics for Health)
AZURE_LANGUAGE_KEY=
AZURE_LANGUAGE_ENDPOINT=https://SEU-RECURSO.cognitiveservices.azure.com/
AZURE_TEXT_LANGUAGE=pt-BR
AZURE_HEALTH_LANGUAGE=pt

# E-mail para a equipe médica (opcional; sem isto os alertas vão para runtime/outbox/*.eml)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
SMTP_STARTTLS=true

# Dispositivo do YOLO: auto (CUDA se houver, senão CPU), cpu, mps (Apple) ou cuda:0
TC4_DEVICE=auto
